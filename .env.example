# Contact form configuration — copy this file to `.env.local` and fill in real values.
# These are server-only variables (no NEXT_PUBLIC_ prefix) — they are never sent to
# the browser. Set the same variables in your Vercel dashboard under
# Project → Settings → Environment Variables.

# Resend API key — get from resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# AI-generated /llms.txt (optional) — scripts/generate-llms-ai.mjs
# Runs before `next build`; set ONE of these keys to enable the AI pass.
# Without a key the build still succeeds and serves the deterministic
# llms.txt built from src/constants. Note: Groq (console.groq.com, gsk_...)
# and xAI's Grok (console.x.ai, xai-...) are different services — keys are
# auto-routed to the right API by their prefix.
# ---------------------------------------------------------------------------

# Anthropic Claude — get from console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# Groq — get from console.groq.com/keys
# GROQ_API_KEY=gsk_your_key_here

# xAI Grok — get from console.x.ai
# XAI_API_KEY=xai-your_key_here

# Optional overrides: force a provider / model instead of auto-detection
# LLMS_PROVIDER=anthropic|groq|grok
# LLMS_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# SEO — Google Search Console ownership verification (optional).
# Get the code from search.google.com/search-console → Settings →
# Ownership verification → HTML tag (only the content="..." value).
# ---------------------------------------------------------------------------
# GOOGLE_SITE_VERIFICATION=your_verification_code_here
